{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://pairo-tk2g.onrender.com/api/$1" },
    { "source": "/health", "destination": "https://pairo-tk2g.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
