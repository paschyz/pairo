{
  "name": "pairo-showreel",
  "version": "1.0.0",
  "description": "Pairo showreel: 20 s motion-graphics film with an original piano score",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "score": "uv run score/score.py",
    "render": "remotion render PairoShowreel out/pairo-showreel-1080p.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709 --audio-bitrate=320k --jpeg-quality=95",
    "verify": "uv run score/score.py verify out/pairo-showreel-1080p.mp4",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
