# Pairo backend configuration
# Copy to .env and fill in values
# Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./pairo.private-key.pem
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL_DEFAULT=
LLM_MODEL_LARGE=
LLM_RPM_LIMIT=15
DAILY_REVIEW_QUOTA=50

# Local dev: SQLite (default)
DATABASE_URL=sqlite:///./pairo.db
# Supabase (prod): uncomment and fill
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DASHBOARD_ORIGIN=http://localhost:3000

# Webhook forwarding (run in separate terminal if not using make dev):
# npx smee-client -u $SMEE_URL -t http://localhost:8000/webhook
SMEE_URL=
